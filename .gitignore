# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class

# Python 虚拟环境
.venv/
venv/
env/
ENV/

# Conda 环境相关
.conda/
conda-meta/

# 环境变量和密钥
.env
.env.*
!.env.example

# IDE 配置
.idea/
.vscode/
*.iml

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# Python 测试和覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# 类型检查和代码检查缓存
.mypy_cache/
.ruff_cache/
.pyright/

# 构建产物
build/
dist/
*.egg-info/
.eggs/

# 日志文件
logs/
*.log

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~

# Agent 运行产生的数据
